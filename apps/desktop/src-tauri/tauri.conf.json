{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FileMind",
  "version": "0.1.0",
  "identifier": "ai.filemind.desktop",
  "build": {
    "beforeDevCommand": "npm run sidecar -- --debug && npm run dev",
    "devUrl": "http://localhost:14210",
    "beforeBuildCommand": "npm run sidecar -- --release && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "FileMind",
        "width": 1180,
        "height": 780,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "REPLACE_WITH_OUTPUT_OF_tauri_signer_generate",
      "endpoints": ["https://github.com/subfrecuency/filemind/releases/latest/download/latest.json"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": ["icons/icon.png"],
    "externalBin": ["binaries/filemind-agent", "binaries/filemind"],
    "category": "Utility",
    "shortDescription": "Local-first file health, search and cleanup",
    "macOS": {
      "minimumSystemVersion": "14.0",
      "entitlements": "entitlements.plist"
    }
  }
}
