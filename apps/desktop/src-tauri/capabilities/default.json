{
  "$schema": "https://schema.tauri.app/config/2/capability",
  "identifier": "default",
  "description": "Main window: local RPC, folder picker, reveal in file manager.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "opener:allow-reveal-item-in-dir",
    "opener:allow-open-path",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://github.com/subfrecuency/filemind/*" }, { "url": "mailto:*" }]
    }
  ]
}
